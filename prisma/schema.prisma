generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false) @map("email_verified")
  image               String?
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")
  acceptedTermsAt     DateTime? @map("accepted_terms_at")
  acceptedPrivacyAt   DateTime? @map("accepted_privacy_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]

  companiesCreated Company[] @relation("CompanyCreatedBy")
  companiesOwned   Company[] @relation("CompanyAccountOwner")
  companiesUpdated Company[] @relation("CompanyUpdatedBy")

  peopleCreated Person[] @relation("PersonCreatedBy")
  peopleUpdated Person[] @relation("PersonUpdatedBy")

  opportunitiesCreated Opportunity[] @relation("OpportunityCreatedBy")
  opportunitiesUpdated Opportunity[] @relation("OpportunityUpdatedBy")
  opportunitiesOwned   Opportunity[] @relation("OpportunityOwner")

  tasksCreated  Task[] @relation("TaskCreatedBy")
  tasksUpdated  Task[] @relation("TaskUpdatedBy")
  tasksAssigned Task[] @relation("TaskAssignee")

  notesCreated Note[] @relation("NoteCreatedBy")
  notesUpdated Note[] @relation("NoteUpdatedBy")

  dashboardsCreated Dashboard[] @relation("DashboardCreatedBy")
  dashboardsUpdated Dashboard[] @relation("DashboardUpdatedBy")

  socialConnectionsCreated SocialConnection[] @relation("SocialConnectionCreatedBy")
  socialConnectionsUpdated SocialConnection[] @relation("SocialConnectionUpdatedBy")

  integrationApiKeysCreated IntegrationApiKey[] @relation("IntegrationApiKeyCreatedBy")

  emailTemplatesCreated EmailTemplate[] @relation("EmailTemplateCreatedBy")
  emailTemplatesUpdated EmailTemplate[] @relation("EmailTemplateUpdatedBy")
  emailCampaignsCreated EmailCampaign[] @relation("EmailCampaignCreatedBy")

  workspaceInvitesCreated WorkspaceInvite[] @relation("WorkspaceInviteCreator")

  workflowsCreated    Workflow[]    @relation("WorkflowCreatedBy")
  workflowsUpdated    Workflow[]    @relation("WorkflowUpdatedBy")
  workflowRunsStarted WorkflowRun[] @relation("WorkflowRunStartedBy")

  proposalsCreated Proposal[] @relation("ProposalCreatedBy")
  proposalsUpdated Proposal[] @relation("ProposalUpdatedBy")

  aiConversations AiConversation[] @relation("AiConversationUser")

  @@index([deletionScheduledAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

model Workspace {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  memberships        Membership[]
  companies          Company[]
  people             Person[]
  opportunities      Opportunity[]
  tasks              Task[]
  notes              Note[]
  dashboards         Dashboard[]
  socialConnections  SocialConnection[]
  integrationApiKeys IntegrationApiKey[]
  emailTemplates     EmailTemplate[]
  emailCampaigns     EmailCampaign[]
  workflows          Workflow[]
  proposals          Proposal[]
  aiConversations    AiConversation[]
  invite             WorkspaceInvite?

  @@map("workspaces")
}

/// Empresa/cliente — entidade central do CRM, escopada por workspace.
/// People, tasks, notes e opportunities são entidades à parte que apontam
/// para Company (FK + relação reversa adicionadas quando cada uma for criada).
model Company {
  id             String    @id @default(cuid())
  name           String
  domain         String?
  employees      Int?
  linkedin       String?
  address        String?
  arr            Decimal?  @db.Decimal(14, 2)
  icp            Boolean   @default(false)
  workspaceId    String    @map("workspace_id")
  createdById    String    @map("created_by_id")
  accountOwnerId String?   @map("account_owner_id")
  updatedById    String?   @map("updated_by_id")
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  accountOwner User?     @relation("CompanyAccountOwner", fields: [accountOwnerId], references: [id])
  updatedBy    User?     @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])

  people        Person[]
  opportunities Opportunity[]
  tasks         Task[]
  notes         Note[]

  @@unique([workspaceId, domain])
  @@index([workspaceId])
  @@index([accountOwnerId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("companies")
}

/// Pessoa/contato do CRM, escopada por workspace e opcionalmente ligada a uma Company.
model Person {
  id          String    @id @default(cuid())
  name        String
  emails      String[]  @default([])
  phones      String[]  @default([])
  city        String?
  jobTitle    String?   @map("job_title")
  linkedin    String?
  avatar      String?
  companyId   String?   @map("company_id")
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User      @relation("PersonCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("PersonUpdatedBy", fields: [updatedById], references: [id])

  opportunities Opportunity[] @relation("OpportunityPointOfContact")
  tasks         Task[]
  notes         Note[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("people")
}

/// Oportunidade/negócio do CRM, escopada por workspace.
model Opportunity {
  id               String           @id @default(cuid())
  name             String
  amount           Decimal?         @db.Decimal(14, 2)
  closeDate        DateTime?        @map("close_date")
  stage            OpportunityStage @default(NEW)
  companyId        String?          @map("company_id")
  pointOfContactId String?          @map("point_of_contact_id")
  ownerId          String?          @map("owner_id")
  workspaceId      String           @map("workspace_id")
  createdById      String           @map("created_by_id")
  updatedById      String?          @map("updated_by_id")
  position         Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pointOfContact Person?   @relation("OpportunityPointOfContact", fields: [pointOfContactId], references: [id], onDelete: SetNull)
  owner          User?     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User      @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?     @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id])

  tasks Task[]
  notes Note[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([pointOfContactId])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("opportunities")
}

/// Tarefa do CRM. As "relações" apontam para até uma Company, Person e/ou Opportunity.
model Task {
  id            String     @id @default(cuid())
  title         String
  status        TaskStatus @default(TODO)
  body          String?
  dueDate       DateTime?  @map("due_date")
  assigneeId    String?    @map("assignee_id")
  companyId     String?    @map("company_id")
  personId      String?    @map("person_id")
  opportunityId String?    @map("opportunity_id")
  workspaceId   String     @map("workspace_id")
  createdById   String     @map("created_by_id")
  updatedById   String?    @map("updated_by_id")
  position      Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("TaskUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([assigneeId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("tasks")
}

/// Anotação do CRM. A "relação" aponta para até uma Company, Person e/ou Opportunity.
model Note {
  id            String    @id @default(cuid())
  title         String?
  body          String?
  companyId     String?   @map("company_id")
  personId      String?   @map("person_id")
  opportunityId String?   @map("opportunity_id")
  workspaceId   String    @map("workspace_id")
  createdById   String    @map("created_by_id")
  updatedById   String?   @map("updated_by_id")
  position      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("NoteCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("NoteUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("notes")
}

model Dashboard {
  id           String    @id @default(cuid())
  title        String
  pageLayoutId String?   @map("page_layout_id")
  workspaceId  String    @map("workspace_id")
  createdById  String    @map("created_by_id")
  updatedById  String?   @map("updated_by_id")
  position     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User              @relation("DashboardCreatedBy", fields: [createdById], references: [id])
  updatedBy User?             @relation("DashboardUpdatedBy", fields: [updatedById], references: [id])
  widgets   DashboardWidget[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("dashboards")
}

enum WidgetType {
  CHART
  VIEW
  IFRAME
  RICH_TEXT
}

model DashboardWidget {
  id          String     @id @default(cuid())
  dashboardId String     @map("dashboard_id")
  type        WidgetType
  x           Int        @default(0)
  y           Int        @default(0)
  w           Int        @default(4)
  h           Int        @default(6)
  config      Json
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  GOOGLE_ANALYTICS
  TWITTER
}

enum SocialConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
}

/// Conta de rede social da empresa conectada via OAuth, escopada por workspace.
/// Uma conexão por plataforma (@@unique). Tokens são cifrados em repouso
/// (AES-256-GCM) pela camada de serviço — o banco guarda só o ciphertext.
model SocialConnection {
  id                String                 @id @default(cuid())
  platform          SocialPlatform
  externalAccountId String                 @map("external_account_id")
  accountName       String?                @map("account_name")
  accessToken       String                 @map("access_token")
  refreshToken      String?                @map("refresh_token")
  tokenExpiresAt    DateTime?              @map("token_expires_at")
  scope             String?
  status            SocialConnectionStatus @default(CONNECTED)
  workspaceId       String                 @map("workspace_id")
  createdById       String                 @map("created_by_id")
  updatedById       String?                @map("updated_by_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SocialConnectionCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("SocialConnectionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([workspaceId, platform])
  @@index([workspaceId])
  @@map("social_connections")
}

/// Chave de API por workspace para ingestão server-to-server (ex.: outros
/// sistemas da empresa enviando contatos). Guardamos só o hash SHA-256 do
/// segredo — o texto puro é mostrado uma única vez na geração. `createdBy` é o
/// usuário que gerou a chave e vira o autor dos registros ingeridos por ela.
model IntegrationApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique @map("key_hash")
  prefix      String
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("IntegrationApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("integration_api_keys")
}

enum OpportunityStage {
  NEW
  QUALIFIED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Convite por link compartilhável (1 por workspace).
/// O token vira parte da URL pública `/invite/<token>`. Role é o que o
/// aceitante recebe na membership criada — OWNER nunca é distribuído por link.
model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String   @unique @map("workspace_id")
  token       String   @unique
  role        Role     @default(MEMBER)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WorkspaceInviteCreator", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("workspace_invites")
}

/// Template reutilizável de email marketing — assunto + corpo HTML gerados
/// pelo editor (@react-email/editor). `contentJson` guarda o estado bruto do
/// editor para reabrir/editar sem regredir formatação.
model EmailTemplate {
  id          String    @id @default(cuid())
  name        String
  subject     String
  contentHtml String    @map("content_html")
  contentJson String?   @map("content_json")
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([deletedAt])
  @@map("email_templates")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum CampaignRecipientScope {
  ALL
  SELECTED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

/// Campanha de email marketing. Cada campanha persiste um snapshot do
/// conteúdo no momento do envio + a lista de destinatários (vide
/// `EmailCampaignRecipient`). `scheduledAt` usa o `scheduled_at` nativo do
/// Resend — nenhum job runner próprio é necessário.
model EmailCampaign {
  id             String                 @id @default(cuid())
  subject        String
  contentHtml    String                 @map("content_html")
  contentJson    String?                @map("content_json")
  fromAddress    String                 @map("from_address")
  status         CampaignStatus         @default(DRAFT)
  recipientScope CampaignRecipientScope @map("recipient_scope")
  scheduledAt    DateTime?              @map("scheduled_at")
  sentAt         DateTime?              @map("sent_at")
  workspaceId    String                 @map("workspace_id")
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  workspace  Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User                     @relation("EmailCampaignCreatedBy", fields: [createdById], references: [id])
  recipients EmailCampaignRecipient[]

  @@index([workspaceId])
  @@index([status])
  @@map("email_campaigns")
}

/// Linha por destinatário da campanha. Mantém um snapshot do email/nome no
/// momento do envio (mesmo que a Pessoa seja editada/removida depois). O
/// `providerMessageId` é o id retornado pelo Resend, útil pra correlacionar
/// webhooks/bounces futuros.
model EmailCampaignRecipient {
  id                String                  @id @default(cuid())
  campaignId        String                  @map("campaign_id")
  personId          String?                 @map("person_id")
  email             String
  name              String?
  status            CampaignRecipientStatus @default(PENDING)
  providerMessageId String?                 @map("provider_message_id")
  errorMessage      String?                 @map("error_message")
  sentAt            DateTime?               @map("sent_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([personId])
  @@index([status])
  @@map("email_campaign_recipients")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  DEACTIVATED
}

enum WorkflowVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELED
}

enum WorkflowRunStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum WorkflowTriggerType {
  RECORD_IS_CREATED
  RECORD_IS_UPDATED
  RECORD_IS_DELETED
  RECORD_IS_CREATED_OR_UPDATED
  LAUNCH_MANUALLY
  ON_A_SCHEDULE
  WEBHOOK
}

/// Workflow é o "container" que agrupa versões e runs. O grafo (nodes/edges +
/// trigger) vive em `WorkflowVersion.definition` — alterações sempre acontecem
/// no draft; `Activate` congela o draft (vira ACTIVE) e arquiva o ACTIVE
/// anterior. `activeVersionId` aponta a versão consultada pelos dispatchers.
model Workflow {
  id              String         @id @default(cuid())
  name            String
  description     String?
  status          WorkflowStatus @default(DRAFT)
  workspaceId     String         @map("workspace_id")
  createdById     String         @map("created_by_id")
  updatedById     String?        @map("updated_by_id")
  activeVersionId String?        @unique @map("active_version_id")
  lastRunAt       DateTime?      @map("last_run_at")
  position        Int            @default(0)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User              @relation("WorkflowCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?             @relation("WorkflowUpdatedBy", fields: [updatedById], references: [id])
  activeVersion WorkflowVersion?  @relation("WorkflowActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      WorkflowVersion[] @relation("WorkflowVersions")
  runs          WorkflowRun[]

  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("workflows")
}

/// Versão imutável de um Workflow. `definition` é o JSON validado pelo schema
/// Zod (trigger + nodes + edges). DRAFT é editável; ACTIVE/ARCHIVED são
/// snapshots — runs antigas referenciam a versão usada no disparo.
model WorkflowVersion {
  id         String                @id @default(cuid())
  workflowId String                @map("workflow_id")
  version    Int                   @default(1)
  status     WorkflowVersionStatus @default(DRAFT)
  definition Json
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  workflow Workflow      @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  activeOf Workflow?     @relation("WorkflowActiveVersion")
  runs     WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([status])
  @@map("workflow_versions")
}

/// Execução de um Workflow a partir de um trigger. Aponta para a versão usada
/// (snapshot); `triggerPayload` guarda o input que iniciou a run (record
/// criado, payload manual, body do webhook, etc.).
model WorkflowRun {
  id             String              @id @default(cuid())
  workflowId     String              @map("workflow_id")
  versionId      String              @map("version_id")
  status         WorkflowRunStatus   @default(PENDING)
  triggerType    WorkflowTriggerType @map("trigger_type")
  triggerPayload Json                @default("{}") @map("trigger_payload")
  /// Snapshot do scope quando o run pausa em um form node — usado para
  /// retomar a execução exatamente do ponto onde parou. Null quando o run
  /// não está em WAITING.
  state          Json?
  /// Id do step (form) que está aguardando input humano. Null quando não
  /// está pausado.
  waitingStepId  String?             @map("waiting_step_id")
  startedById    String?             @map("started_by_id")
  error          String?
  startedAt      DateTime?           @map("started_at")
  finishedAt     DateTime?           @map("finished_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version   WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  startedBy User?             @relation("WorkflowRunStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  steps     WorkflowRunStep[]

  @@index([workflowId])
  @@index([versionId])
  @@index([status])
  @@index([workflowId, createdAt])
  @@map("workflow_runs")
}

/// Linha por node executado dentro de uma run. `input` e `output` são JSON
/// livre — o executor de cada tipo de node decide a forma. `error` carrega
/// stack/mensagem em caso de FAILED.
model WorkflowRunStep {
  id         String                @id @default(cuid())
  runId      String                @map("run_id")
  nodeId     String                @map("node_id")
  nodeType   String                @map("node_type")
  status     WorkflowRunStepStatus @default(PENDING)
  input      Json?
  output     Json?
  error      String?
  startedAt  DateTime?             @map("started_at")
  finishedAt DateTime?             @map("finished_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
  @@map("workflow_run_steps")
}

enum AiMessageRole {
  USER
  ASSISTANT
}

/// Conversa do agente de IA do workspace. Privada por usuário (cada membro tem
/// suas próprias conversas) e escopada por workspace. Soft-delete via deletedAt.
model AiConversation {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  userId      String      @map("user_id")
  title       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation("AiConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([workspaceId, userId])
  @@map("ai_conversations")
}

/// Mensagem de uma conversa. `toolCalls` registra (apenas para transparência)
/// quais tools de leitura o agente acionou ao gerar a resposta — não é exposto
/// no DTO público de mensagem.
model AiMessage {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String
  toolCalls      Json?         @map("tool_calls")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

enum ProposalStatus {
  DRAFT
  PUBLISHED
}

/// Documento de proposta rico (HTML do TipTap), escopado por workspace.
/// `status` PUBLISHED = online: o `shareToken` opaco serve a página pública
/// (`/p/<token>`) sem auth. Soft-delete via `deletedAt`. As métricas de
/// leitura ficam em ProposalView.
model Proposal {
  id          String         @id @default(cuid())
  title       String
  content     String         @default("") @db.Text
  status      ProposalStatus @default(DRAFT)
  shareToken  String         @unique @map("share_token")
  publishedAt DateTime?      @map("published_at")
  workspaceId String         @map("workspace_id")
  createdById String         @map("created_by_id")
  updatedById String?        @map("updated_by_id")
  position    Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("ProposalUpdatedBy", fields: [updatedById], references: [id])

  views ProposalView[]

  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("proposals")
}

/// Uma sessão de visita à proposta pública. Upsertada por `viewId` (id de
/// sessão gerado no cliente), de modo que beacons sucessivos da mesma visita
/// atualizam a mesma linha. `ipHash` é um hash salgado do IP — nunca o IP cru
/// (LGPD); serve só para contar visitantes únicos.
model ProposalView {
  id          String   @id @default(cuid())
  proposalId  String   @map("proposal_id")
  viewId      String   @map("view_id")
  ipHash      String   @map("ip_hash")
  durationMs  Int      @default(0) @map("duration_ms")
  reachedEnd  Boolean  @default(false) @map("reached_end")
  scrolledPct Int      @default(0) @map("scrolled_pct")
  referrer    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, viewId])
  @@index([proposalId])
  @@index([proposalId, ipHash])
  @@map("proposal_views")
}
