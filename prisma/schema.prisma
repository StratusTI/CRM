generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false) @map("email_verified")
  image               String?
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")
  acceptedTermsAt     DateTime? @map("accepted_terms_at")
  acceptedPrivacyAt   DateTime? @map("accepted_privacy_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]

  companiesCreated Company[] @relation("CompanyCreatedBy")
  companiesOwned   Company[] @relation("CompanyAccountOwner")
  companiesUpdated Company[] @relation("CompanyUpdatedBy")

  peopleCreated Person[] @relation("PersonCreatedBy")
  peopleUpdated Person[] @relation("PersonUpdatedBy")

  opportunitiesCreated Opportunity[] @relation("OpportunityCreatedBy")
  opportunitiesUpdated Opportunity[] @relation("OpportunityUpdatedBy")
  opportunitiesOwned   Opportunity[] @relation("OpportunityOwner")

  pipelinesCreated Pipeline[] @relation("PipelineCreatedBy")
  pipelinesUpdated Pipeline[] @relation("PipelineUpdatedBy")

  productsCreated Product[] @relation("ProductCreatedBy")
  productsUpdated Product[] @relation("ProductUpdatedBy")

  quotasOwned   Quota[] @relation("QuotaOwner")
  quotasCreated Quota[] @relation("QuotaCreatedBy")
  quotasUpdated Quota[] @relation("QuotaUpdatedBy")

  customFieldsCreated CustomFieldDefinition[] @relation("CustomFieldCreatedBy")
  customFieldsUpdated CustomFieldDefinition[] @relation("CustomFieldUpdatedBy")

  tasksCreated  Task[] @relation("TaskCreatedBy")
  tasksUpdated  Task[] @relation("TaskUpdatedBy")
  tasksAssigned Task[] @relation("TaskAssignee")

  notesCreated Note[] @relation("NoteCreatedBy")
  notesUpdated Note[] @relation("NoteUpdatedBy")

  dashboardsCreated Dashboard[] @relation("DashboardCreatedBy")
  dashboardsUpdated Dashboard[] @relation("DashboardUpdatedBy")

  socialConnectionsCreated SocialConnection[] @relation("SocialConnectionCreatedBy")
  socialConnectionsUpdated SocialConnection[] @relation("SocialConnectionUpdatedBy")

  scheduledPostsCreated ScheduledPost[] @relation("ScheduledPostCreatedBy")

  integrationApiKeysCreated IntegrationApiKey[] @relation("IntegrationApiKeyCreatedBy")

  emailTemplatesCreated EmailTemplate[] @relation("EmailTemplateCreatedBy")
  emailTemplatesUpdated EmailTemplate[] @relation("EmailTemplateUpdatedBy")
  emailCampaignsCreated EmailCampaign[] @relation("EmailCampaignCreatedBy")
  mailingListsCreated   MailingList[]   @relation("MailingListCreatedBy")

  workspaceInvitesCreated WorkspaceInvite[] @relation("WorkspaceInviteCreator")

  workflowsCreated    Workflow[]    @relation("WorkflowCreatedBy")
  workflowsUpdated    Workflow[]    @relation("WorkflowUpdatedBy")
  workflowRunsStarted WorkflowRun[] @relation("WorkflowRunStartedBy")

  proposalsCreated Proposal[] @relation("ProposalCreatedBy")
  proposalsUpdated Proposal[] @relation("ProposalUpdatedBy")

  documentTemplatesCreated DocumentTemplate[] @relation("DocumentTemplateCreatedBy")

  landingPagesCreated LandingPage[] @relation("LandingPageCreatedBy")
  landingPagesUpdated LandingPage[] @relation("LandingPageUpdatedBy")

  formsCreated Form[] @relation("FormCreatedBy")
  formsUpdated Form[] @relation("FormUpdatedBy")

  aiConversations AiConversation[] @relation("AiConversationUser")

  @@index([deletionScheduledAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

model Workspace {
  id                 String                  @id @default(cuid())
  name               String
  slug               String                  @unique
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  memberships        Membership[]
  companies          Company[]
  people             Person[]
  pipelines          Pipeline[]
  products           Product[]
  quotas             Quota[]
  customFields       CustomFieldDefinition[]
  profiles           Profile[]
  opportunities      Opportunity[]
  tasks              Task[]
  notes              Note[]
  dashboards         Dashboard[]
  socialConnections  SocialConnection[]
  scheduledPosts     ScheduledPost[]
  integrationApiKeys IntegrationApiKey[]
  emailTemplates     EmailTemplate[]
  emailCampaigns     EmailCampaign[]
  mailingLists       MailingList[]
  workflows          Workflow[]
  proposals          Proposal[]
  documentTemplates  DocumentTemplate[]
  landingPages       LandingPage[]
  forms              Form[]
  aiConversations    AiConversation[]
  aiUsage            AiUsage[]
  invite             WorkspaceInvite?

  @@map("workspaces")
}

/// Empresa/cliente — entidade central do CRM, escopada por workspace.
/// People, tasks, notes e opportunities são entidades à parte que apontam
/// para Company (FK + relação reversa adicionadas quando cada uma for criada).
model Company {
  id             String    @id @default(cuid())
  name           String    @default("")
  cnpj           String?
  domain         String?
  employees      Int?
  linkedin       String?
  address        Json?
  arr            Decimal?  @db.Decimal(14, 2)
  icp            Boolean   @default(false)
  workspaceId    String    @map("workspace_id")
  createdById    String    @map("created_by_id")
  accountOwnerId String?   @map("account_owner_id")
  updatedById    String?   @map("updated_by_id")
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  accountOwner User?     @relation("CompanyAccountOwner", fields: [accountOwnerId], references: [id])
  updatedBy    User?     @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])

  people        Person[]
  opportunities Opportunity[]
  tasks         Task[]
  notes         Note[]

  @@unique([workspaceId, domain])
  @@unique([workspaceId, cnpj])
  @@index([workspaceId])
  @@index([accountOwnerId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("companies")
}

/// Pessoa/contato do CRM, escopada por workspace e opcionalmente ligada a uma Company.
model Person {
  id          String    @id @default(cuid())
  name        String
  emails      String[]  @default([])
  phones      String[]  @default([])
  city        String?
  jobTitle    String?   @map("job_title")
  linkedin    String?
  avatar      String?
  companyId   String?   @map("company_id")
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User      @relation("PersonCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("PersonUpdatedBy", fields: [updatedById], references: [id])

  opportunities Opportunity[] @relation("OpportunityPointOfContact")
  tasks         Task[]
  notes         Note[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("people")
}

/// Oportunidade/negócio do CRM, escopada por workspace.
model Opportunity {
  id               String    @id @default(cuid())
  name             String
  amount           Decimal?  @db.Decimal(14, 2)
  closeDate        DateTime? @map("close_date")
  pipelineId       String    @map("pipeline_id")
  stageId          String    @map("stage_id")
  companyId        String?   @map("company_id")
  pointOfContactId String?   @map("point_of_contact_id")
  ownerId          String?   @map("owner_id")
  source           String?
  workspaceId      String    @map("workspace_id")
  createdById      String    @map("created_by_id")
  updatedById      String?   @map("updated_by_id")
  position         Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pointOfContact Person?       @relation("OpportunityPointOfContact", fields: [pointOfContactId], references: [id], onDelete: SetNull)
  owner          User?         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User          @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?         @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id])

  tasks     Task[]
  notes     Note[]
  lineItems OpportunityLineItem[]

  @@index([workspaceId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([companyId])
  @@index([pointOfContactId])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("opportunities")
}

enum BillingType {
  ONE_TIME
  MONTHLY
  YEARLY
}

/// Produto/serviço do catálogo da workspace (preço base + tipo de cobrança).
model Product {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  name        String
  sku         String?
  description String?
  unitPrice   Decimal     @default(0) @map("unit_price") @db.Decimal(14, 2)
  currency    String      @default("BRL")
  billingType BillingType @default(ONE_TIME) @map("billing_type")
  active      Boolean     @default(true)
  position    Int         @default(0)
  createdById String      @map("created_by_id")
  updatedById String?     @map("updated_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  lineItems OpportunityLineItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@index([workspaceId, position])
  @@index([deletedAt])
  @@map("products")
}

/// Item de uma oportunidade. Faz snapshot do produto (nome/preço/cobrança) para
/// preservar o histórico mesmo que o produto mude ou seja excluído. `total` é
/// denormalizado (quantity * unitPrice * (1 - discountPct/100)).
model OpportunityLineItem {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  productId     String?     @map("product_id")
  name          String
  quantity      Int         @default(1)
  unitPrice     Decimal     @default(0) @map("unit_price") @db.Decimal(14, 2)
  discountPct   Decimal     @default(0) @map("discount_pct") @db.Decimal(5, 2)
  billingType   BillingType @default(ONE_TIME) @map("billing_type")
  total         Decimal     @default(0) @db.Decimal(14, 2)
  position      Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([opportunityId, position])
  @@index([productId])
  @@map("opportunity_line_items")
}

/// Funil de vendas configurável por workspace. Substitui o antigo enum de etapas.
model Pipeline {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  position    Int       @default(0)
  isDefault   Boolean   @default(false) @map("is_default")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("PipelineCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("PipelineUpdatedBy", fields: [updatedById], references: [id])

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([workspaceId])
  @@index([workspaceId, position])
  @@index([deletedAt])
  @@map("pipelines")
}

/// Etapa de um pipeline. `probability` (0–100) e `category` alimentam o forecast.
model PipelineStage {
  id          String        @id @default(cuid())
  pipelineId  String        @map("pipeline_id")
  name        String
  position    Int           @default(0)
  probability Int           @default(0)
  category    StageCategory @default(OPEN)
  color       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([pipelineId])
  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

enum QuotaPeriod {
  MONTH
  QUARTER
}

enum CustomFieldEntity {
  COMPANY
  PERSON
  OPPORTUNITY
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// Definição de um campo customizado (no-code) por workspace e entidade.
model CustomFieldDefinition {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  entity      CustomFieldEntity
  key         String
  label       String
  type        CustomFieldType   @default(TEXT)
  options     String[]          @default([])
  required    Boolean           @default(false)
  position    Int               @default(0)
  createdById String            @map("created_by_id")
  updatedById String?           @map("updated_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CustomFieldCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CustomFieldUpdatedBy", fields: [updatedById], references: [id])

  values CustomFieldValue[]

  @@unique([workspaceId, entity, key])
  @@index([workspaceId, entity])
  @@index([deletedAt])
  @@map("custom_field_definitions")
}

/// Valor de um campo customizado para um registro (Company/Person/Opportunity).
/// `recordId` é o id do registro da entidade da definição. `value` é JSON tipado.
model CustomFieldValue {
  id           String   @id @default(cuid())
  definitionId String   @map("definition_id")
  recordId     String   @map("record_id")
  value        Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, recordId])
  @@index([recordId])
  @@index([definitionId])
  @@map("custom_field_values")
}

/// Meta de receita de um responsável num período (mês "2026-06" ou trimestre
/// "2026-Q2"). Comparada ao forecast (ganho + pipeline aberto ponderado).
model Quota {
  id           String      @id @default(cuid())
  workspaceId  String      @map("workspace_id")
  ownerId      String      @map("owner_id")
  period       QuotaPeriod
  periodKey    String      @map("period_key")
  targetAmount Decimal     @default(0) @map("target_amount") @db.Decimal(14, 2)
  createdById  String      @map("created_by_id")
  updatedById  String?     @map("updated_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("QuotaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy User      @relation("QuotaCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("QuotaUpdatedBy", fields: [updatedById], references: [id])

  @@unique([workspaceId, ownerId, period, periodKey])
  @@index([workspaceId])
  @@index([workspaceId, period, periodKey])
  @@map("quotas")
}

/// Tarefa do CRM. As "relações" apontam para até uma Company, Person e/ou Opportunity.
model Task {
  id            String     @id @default(cuid())
  title         String
  status        TaskStatus @default(TODO)
  body          String?
  dueDate       DateTime?  @map("due_date")
  assigneeId    String?    @map("assignee_id")
  companyId     String?    @map("company_id")
  personId      String?    @map("person_id")
  opportunityId String?    @map("opportunity_id")
  workspaceId   String     @map("workspace_id")
  createdById   String     @map("created_by_id")
  updatedById   String?    @map("updated_by_id")
  position      Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("TaskUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([assigneeId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("tasks")
}

/// Anotação do CRM. A "relação" aponta para até uma Company, Person e/ou Opportunity.
model Note {
  id            String    @id @default(cuid())
  title         String?
  body          String?
  companyId     String?   @map("company_id")
  personId      String?   @map("person_id")
  opportunityId String?   @map("opportunity_id")
  workspaceId   String    @map("workspace_id")
  createdById   String    @map("created_by_id")
  updatedById   String?   @map("updated_by_id")
  position      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("NoteCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("NoteUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("notes")
}

model Dashboard {
  id           String    @id @default(cuid())
  title        String
  pageLayoutId String?   @map("page_layout_id")
  workspaceId  String    @map("workspace_id")
  createdById  String    @map("created_by_id")
  updatedById  String?   @map("updated_by_id")
  position     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User              @relation("DashboardCreatedBy", fields: [createdById], references: [id])
  updatedBy User?             @relation("DashboardUpdatedBy", fields: [updatedById], references: [id])
  widgets   DashboardWidget[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("dashboards")
}

enum WidgetType {
  CHART
  VIEW
  IFRAME
  RICH_TEXT
}

model DashboardWidget {
  id          String     @id @default(cuid())
  dashboardId String     @map("dashboard_id")
  type        WidgetType
  x           Int        @default(0)
  y           Int        @default(0)
  w           Int        @default(4)
  h           Int        @default(6)
  config      Json
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  GOOGLE_ANALYTICS
  TWITTER
  GOOGLE_ADS
  LINKEDIN
}

enum SocialConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
}

/// Estado do post agendado como um todo. PARTIALLY_FAILED = ao menos um alvo
/// publicou e ao menos um falhou (vide ScheduledPostTarget para o detalhe).
enum ScheduledPostStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_FAILED
  FAILED
  CANCELED
}

/// Estado da publicação em UMA plataforma do post (o "fan-out").
enum ScheduledPostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

/// Tipo de mídia anexada — determina para quais plataformas o post é elegível
/// (ex.: VIDEO habilita YouTube/TikTok; IMAGE habilita Instagram).
enum ScheduledMediaKind {
  IMAGE
  VIDEO
}

/// Conta de rede social da empresa conectada via OAuth, escopada por workspace.
/// Uma conexão por plataforma (@@unique). Tokens são cifrados em repouso
/// (AES-256-GCM) pela camada de serviço — o banco guarda só o ciphertext.
model SocialConnection {
  id                String                 @id @default(cuid())
  platform          SocialPlatform
  externalAccountId String                 @map("external_account_id")
  accountName       String?                @map("account_name")
  accessToken       String                 @map("access_token")
  refreshToken      String?                @map("refresh_token")
  tokenExpiresAt    DateTime?              @map("token_expires_at")
  scope             String?
  status            SocialConnectionStatus @default(CONNECTED)
  workspaceId       String                 @map("workspace_id")
  createdById       String                 @map("created_by_id")
  updatedById       String?                @map("updated_by_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SocialConnectionCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("SocialConnectionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([workspaceId, platform])
  @@index([workspaceId])
  @@map("social_connections")
}

/// Post agendado (ou publicado "agora") para uma ou mais redes sociais. O texto
/// é compartilhado entre as plataformas; `title`/`options` cobrem requisitos
/// específicos (ex.: título do YouTube, privacidade do TikTok). A mídia fica no
/// MinIO (ver ScheduledPostMedia) e o cron `social-posts-tick` publica os
/// agendamentos vencidos chamando os mesmos services de publicação manual.
model ScheduledPost {
  id           String              @id @default(cuid())
  content      String              @default("")
  title        String?
  options      Json?
  status       ScheduledPostStatus @default(SCHEDULED)
  scheduledFor DateTime            @map("scheduled_for")
  publishedAt  DateTime?           @map("published_at")
  lastError    String?             @map("last_error")
  workspaceId  String              @map("workspace_id")
  createdById  String              @map("created_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                  @relation("ScheduledPostCreatedBy", fields: [createdById], references: [id])
  targets   ScheduledPostTarget[]
  media     ScheduledPostMedia[]

  @@index([workspaceId])
  @@index([status, scheduledFor])
  @@map("scheduled_posts")
}

/// Alvo de publicação: uma plataforma de um ScheduledPost, com status próprio.
/// `externalPostId` guarda o id retornado pela rede após publicar.
model ScheduledPostTarget {
  id             String                    @id @default(cuid())
  postId         String                    @map("post_id")
  platform       SocialPlatform
  status         ScheduledPostTargetStatus @default(PENDING)
  externalPostId String?                   @map("external_post_id")
  error          String?
  attempts       Int                       @default(0)
  publishedAt    DateTime?                 @map("published_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  post ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([postId])
  @@map("scheduled_post_targets")
}

/// Mídia anexada a um ScheduledPost. Os bytes vivem no MinIO sob `storageKey`;
/// aqui guardamos só metadados. `order` mantém a sequência (carrossel/anexos).
model ScheduledPostMedia {
  id          String             @id @default(cuid())
  postId      String             @map("post_id")
  kind        ScheduledMediaKind
  storageKey  String             @map("storage_key")
  contentType String             @map("content_type")
  sizeBytes   Int                @map("size_bytes")
  order       Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at")

  post ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("scheduled_post_media")
}

/// Chave de API por workspace para ingestão server-to-server (ex.: outros
/// sistemas da empresa enviando contatos). Guardamos só o hash SHA-256 do
/// segredo — o texto puro é mostrado uma única vez na geração. `createdBy` é o
/// usuário que gerou a chave e vira o autor dos registros ingeridos por ela.
model IntegrationApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique @map("key_hash")
  prefix      String
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("IntegrationApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("integration_api_keys")
}

enum StageCategory {
  OPEN
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        Role     @default(MEMBER)
  profileId   String?  @map("profile_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([profileId])
  @@map("memberships")
}

/// Perfil de acesso (RBAC). `permissions` é um mapa `recurso → [ações]`.
/// Perfis de sistema (`isSystem`) espelham OWNER/ADMIN/MEMBER e não são editáveis.
model Profile {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  isSystem    Boolean  @default(false) @map("is_system")
  systemKey   String?  @map("system_key")
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("profiles")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Convite por link compartilhável (1 por workspace).
/// O token vira parte da URL pública `/invite/<token>`. Role é o que o
/// aceitante recebe na membership criada — OWNER nunca é distribuído por link.
model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String   @unique @map("workspace_id")
  token       String   @unique
  role        Role     @default(MEMBER)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WorkspaceInviteCreator", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("workspace_invites")
}

/// Template reutilizável de email marketing — assunto + corpo HTML gerados
/// pelo editor (@react-email/editor). `contentJson` guarda o estado bruto do
/// editor para reabrir/editar sem regredir formatação.
model EmailTemplate {
  id          String    @id @default(cuid())
  name        String
  subject     String
  contentHtml String    @map("content_html")
  contentJson String?   @map("content_json")
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([deletedAt])
  @@map("email_templates")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum CampaignRecipientScope {
  ALL
  SELECTED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

/// Campanha de email marketing. Cada campanha persiste um snapshot do
/// conteúdo no momento do envio + a lista de destinatários (vide
/// `EmailCampaignRecipient`). `scheduledAt` usa o `scheduled_at` nativo do
/// Resend — nenhum job runner próprio é necessário.
model EmailCampaign {
  id             String                 @id @default(cuid())
  subject        String
  contentHtml    String                 @map("content_html")
  contentJson    String?                @map("content_json")
  fromAddress    String                 @map("from_address")
  status         CampaignStatus         @default(DRAFT)
  recipientScope CampaignRecipientScope @map("recipient_scope")
  scheduledAt    DateTime?              @map("scheduled_at")
  sentAt         DateTime?              @map("sent_at")
  workspaceId    String                 @map("workspace_id")
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  workspace  Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User                     @relation("EmailCampaignCreatedBy", fields: [createdById], references: [id])
  recipients EmailCampaignRecipient[]

  @@index([workspaceId])
  @@index([status])
  @@map("email_campaigns")
}

/// Linha por destinatário da campanha. Mantém um snapshot do email/nome no
/// momento do envio (mesmo que a Pessoa seja editada/removida depois). O
/// `providerMessageId` é o id retornado pelo Resend, útil pra correlacionar
/// webhooks/bounces futuros.
model EmailCampaignRecipient {
  id                String                  @id @default(cuid())
  campaignId        String                  @map("campaign_id")
  personId          String?                 @map("person_id")
  email             String
  name              String?
  status            CampaignRecipientStatus @default(PENDING)
  providerMessageId String?                 @map("provider_message_id")
  errorMessage      String?                 @map("error_message")
  sentAt            DateTime?               @map("sent_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([personId])
  @@index([status])
  @@map("email_campaign_recipients")
}

/// Lista de distribuição de emails. Agrupa membros (com ou sem vínculo a uma
/// Pessoa do CRM) para facilitar o envio de campanhas a grupos recorrentes.
model MailingList {
  id          String    @id @default(cuid())
  name        String
  description String?
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                @relation("MailingListCreatedBy", fields: [createdById], references: [id])
  members   MailingListMember[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@map("mailing_lists")
}

/// Membro de uma MailingList. Pode ser um email avulso ou vinculado a uma
/// Pessoa do CRM (personId opcional). `email` é único por lista.
model MailingListMember {
  id            String   @id @default(cuid())
  mailingListId String   @map("mailing_list_id")
  email         String
  name          String?
  personId      String?  @map("person_id")
  createdAt     DateTime @default(now()) @map("created_at")

  mailingList MailingList @relation(fields: [mailingListId], references: [id], onDelete: Cascade)

  @@unique([mailingListId, email])
  @@index([mailingListId])
  @@index([personId])
  @@map("mailing_list_members")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  DEACTIVATED
}

enum WorkflowVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELED
}

enum WorkflowRunStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum WorkflowTriggerType {
  RECORD_IS_CREATED
  RECORD_IS_UPDATED
  RECORD_IS_DELETED
  RECORD_IS_CREATED_OR_UPDATED
  LAUNCH_MANUALLY
  ON_A_SCHEDULE
  WEBHOOK
}

/// Workflow é o "container" que agrupa versões e runs. O grafo (nodes/edges +
/// trigger) vive em `WorkflowVersion.definition` — alterações sempre acontecem
/// no draft; `Activate` congela o draft (vira ACTIVE) e arquiva o ACTIVE
/// anterior. `activeVersionId` aponta a versão consultada pelos dispatchers.
model Workflow {
  id              String         @id @default(cuid())
  name            String
  description     String?
  status          WorkflowStatus @default(DRAFT)
  workspaceId     String         @map("workspace_id")
  createdById     String         @map("created_by_id")
  updatedById     String?        @map("updated_by_id")
  activeVersionId String?        @unique @map("active_version_id")
  lastRunAt       DateTime?      @map("last_run_at")
  position        Int            @default(0)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User              @relation("WorkflowCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?             @relation("WorkflowUpdatedBy", fields: [updatedById], references: [id])
  activeVersion WorkflowVersion?  @relation("WorkflowActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      WorkflowVersion[] @relation("WorkflowVersions")
  runs          WorkflowRun[]

  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("workflows")
}

/// Versão imutável de um Workflow. `definition` é o JSON validado pelo schema
/// Zod (trigger + nodes + edges). DRAFT é editável; ACTIVE/ARCHIVED são
/// snapshots — runs antigas referenciam a versão usada no disparo.
model WorkflowVersion {
  id         String                @id @default(cuid())
  workflowId String                @map("workflow_id")
  version    Int                   @default(1)
  status     WorkflowVersionStatus @default(DRAFT)
  definition Json
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  workflow Workflow      @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  activeOf Workflow?     @relation("WorkflowActiveVersion")
  runs     WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([status])
  @@map("workflow_versions")
}

/// Execução de um Workflow a partir de um trigger. Aponta para a versão usada
/// (snapshot); `triggerPayload` guarda o input que iniciou a run (record
/// criado, payload manual, body do webhook, etc.).
model WorkflowRun {
  id             String              @id @default(cuid())
  workflowId     String              @map("workflow_id")
  versionId      String              @map("version_id")
  status         WorkflowRunStatus   @default(PENDING)
  triggerType    WorkflowTriggerType @map("trigger_type")
  triggerPayload Json                @default("{}") @map("trigger_payload")
  /// Snapshot do scope quando o run pausa em um form node — usado para
  /// retomar a execução exatamente do ponto onde parou. Null quando o run
  /// não está em WAITING.
  state          Json?
  /// Id do step (form) que está aguardando input humano. Null quando não
  /// está pausado.
  waitingStepId  String?             @map("waiting_step_id")
  startedById    String?             @map("started_by_id")
  error          String?
  startedAt      DateTime?           @map("started_at")
  finishedAt     DateTime?           @map("finished_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version   WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  startedBy User?             @relation("WorkflowRunStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  steps     WorkflowRunStep[]

  @@index([workflowId])
  @@index([versionId])
  @@index([status])
  @@index([workflowId, createdAt])
  @@map("workflow_runs")
}

/// Linha por node executado dentro de uma run. `input` e `output` são JSON
/// livre — o executor de cada tipo de node decide a forma. `error` carrega
/// stack/mensagem em caso de FAILED.
model WorkflowRunStep {
  id         String                @id @default(cuid())
  runId      String                @map("run_id")
  nodeId     String                @map("node_id")
  nodeType   String                @map("node_type")
  status     WorkflowRunStepStatus @default(PENDING)
  input      Json?
  output     Json?
  error      String?
  startedAt  DateTime?             @map("started_at")
  finishedAt DateTime?             @map("finished_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
  @@map("workflow_run_steps")
}

enum AiMessageRole {
  USER
  ASSISTANT
}

/// Conversa do agente de IA do workspace. Privada por usuário (cada membro tem
/// suas próprias conversas) e escopada por workspace. Soft-delete via deletedAt.
model AiConversation {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  title       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation("AiConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  aiUsage   AiUsage[]

  @@index([workspaceId, userId])
  @@map("ai_conversations")
}

/// Mensagem de uma conversa. `toolCalls` registra (apenas para transparência)
/// quais tools de leitura o agente acionou ao gerar a resposta — não é exposto
/// no DTO público de mensagem.
model AiMessage {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String
  toolCalls      Json?         @map("tool_calls")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

enum ProposalStatus {
  DRAFT
  PUBLISHED
}

/// Classificação do documento. Apenas organiza/filtra e escopa os templates —
/// todos os tipos têm as mesmas capacidades (editor rico, publicação, métricas).
enum DocumentType {
  PREMISES
  PORTFOLIO
  PROPOSAL
  CONTRACT
}

/// Documento rico (HTML do TipTap), escopado por workspace. `status` PUBLISHED
/// = online: o `shareToken` opaco serve a página pública (`/p/<token>`) sem
/// auth. `type` classifica o documento. Soft-delete via `deletedAt`. As
/// métricas de leitura ficam em ProposalView.
model Proposal {
  id          String         @id @default(cuid())
  title       String
  content     String         @default("") @db.Text
  type        DocumentType   @default(PROPOSAL)
  status      ProposalStatus @default(DRAFT)
  shareToken  String         @unique @map("share_token")
  publishedAt DateTime?      @map("published_at")
  workspaceId String         @map("workspace_id")
  createdById String         @map("created_by_id")
  updatedById String?        @map("updated_by_id")
  position    Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("ProposalUpdatedBy", fields: [updatedById], references: [id])

  views ProposalView[]

  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@index([workspaceId, type])
  @@map("proposals")
}

/// Template de documento: snapshot reutilizável (título + conteúdo) escopado
/// por workspace e por `type`. Criado a partir de um documento no editor
/// ("Salvar como template") e consumido ao criar um novo documento do mesmo
/// tipo. Soft-delete via `deletedAt`.
model DocumentTemplate {
  id          String       @id @default(cuid())
  title       String
  content     String       @default("") @db.Text
  type        DocumentType
  workspaceId String       @map("workspace_id")
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, type])
  @@index([deletedAt])
  @@map("document_templates")
}

/// Uma sessão de visita à proposta pública. Upsertada por `viewId` (id de
/// sessão gerado no cliente), de modo que beacons sucessivos da mesma visita
/// atualizam a mesma linha. `ipHash` é um hash salgado do IP — nunca o IP cru
/// (LGPD); serve só para contar visitantes únicos.
model ProposalView {
  id          String   @id @default(cuid())
  proposalId  String   @map("proposal_id")
  viewId      String   @map("view_id")
  ipHash      String   @map("ip_hash")
  durationMs  Int      @default(0) @map("duration_ms")
  reachedEnd  Boolean  @default(false) @map("reached_end")
  scrolledPct Int      @default(0) @map("scrolled_pct")
  referrer    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, viewId])
  @@index([proposalId])
  @@index([proposalId, ipHash])
  @@map("proposal_views")
}

/// Registro de uso de tokens IA por round de agente. Gravado após cada chamada
/// ao modelo, permitindo calcular o custo acumulado por workspace.
model AiUsage {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  conversationId String   @map("conversation_id")
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  model          String
  createdAt      DateTime @default(now()) @map("created_at")

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_usage")
}

enum LandingPageStatus {
  DRAFT
  PUBLISHED
}

/// Landing page gerada por IA (documento HTML autocontido), escopada por
/// workspace. `status` PUBLISHED = online: o `slug` legível serve a página
/// pública (`/<workspace>/pages/<slug>`) sem auth. `slug` é único por workspace.
/// Soft-delete via `deletedAt`. As métricas de acesso ficam em LandingPageView
/// e o histórico do chat de geração em LandingPageMessage.
model LandingPage {
  id          String            @id @default(cuid())
  title       String
  slug        String
  html        String            @default("") @db.Text
  status      LandingPageStatus @default(DRAFT)
  publishedAt DateTime?         @map("published_at")
  workspaceId String            @map("workspace_id")
  createdById String            @map("created_by_id")
  updatedById String?           @map("updated_by_id")
  position    Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("LandingPageCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("LandingPageUpdatedBy", fields: [updatedById], references: [id])

  views    LandingPageView[]
  messages LandingPageMessage[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("landing_pages")
}

/// Uma sessão de visita à landing page pública. Upsertada por `viewId` (id de
/// sessão gerado no cliente), de modo que beacons sucessivos da mesma visita
/// atualizam a mesma linha. `ipHash` é um hash salgado do IP — nunca o IP cru
/// (LGPD); serve só para contar visitantes únicos. `ctaClicks` acumula cliques
/// em botões de conversão; `referrer` registra a origem do tráfego.
model LandingPageView {
  id            String   @id @default(cuid())
  landingPageId String   @map("landing_page_id")
  viewId        String   @map("view_id")
  ipHash        String   @map("ip_hash")
  durationMs    Int      @default(0) @map("duration_ms")
  ctaClicks     Int      @default(0) @map("cta_clicks")
  referrer      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, viewId])
  @@index([landingPageId])
  @@index([landingPageId, ipHash])
  @@map("landing_page_views")
}

/// Mensagem do chat de geração de uma landing page (estilo Lovable/v0).
/// Reusa o enum AiMessageRole. O histórico alimenta o contexto da próxima
/// iteração de edição do HTML.
model LandingPageMessage {
  id            String        @id @default(cuid())
  landingPageId String        @map("landing_page_id")
  role          AiMessageRole
  content       String        @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId])
  @@map("landing_page_messages")
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

/// Ação executada quando o formulário é enviado. Define que entidade(s) o
/// envio cria no CRM (a oportunidade só existe no caso LEAD).
enum FormAction {
  COMPANY
  PERSON
  LEAD
}

/// Formulário customizável de captação, escopado por workspace. O usuário
/// escolhe os campos (`fields`, JSON validado por Zod) e a `action` executada
/// no envio. `status` PUBLISHED = online: o `publicToken` opaco serve a página
/// pública (`/f/<token>`) sem auth. Soft-delete via `deletedAt`. As submissões
/// ficam em FormSubmission.
model Form {
  id              String     @id @default(cuid())
  name            String
  description     String?    @db.Text
  status          FormStatus @default(DRAFT)
  publicToken     String     @unique @map("public_token")
  action          FormAction @default(LEAD)
  /// Array de FieldDefinition (validado por Zod na camada de serviço).
  fields          Json       @default("[]")
  /// Config extra da ação (defaults de oportunidade no LEAD, icp no COMPANY).
  actionConfig    Json       @default("{}") @map("action_config")
  successMessage  String?    @map("success_message")
  redirectUrl     String?    @map("redirect_url")
  submissionCount Int        @default(0) @map("submission_count")
  workspaceId     String     @map("workspace_id")
  createdById     String     @map("created_by_id")
  updatedById     String?    @map("updated_by_id")
  position        Int        @default(0)
  publishedAt     DateTime?  @map("published_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("FormCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("FormUpdatedBy", fields: [updatedById], references: [id])

  submissions FormSubmission[]

  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("forms")
}

/// Uma submissão de um formulário público. Guarda o snapshot dos valores
/// enviados (após validação) e os ids dos registros criados/reutilizados pela
/// ação. O IP nunca é guardado cru (LGPD) — só um hash salgado.
model FormSubmission {
  id                   String     @id @default(cuid())
  formId               String     @map("form_id")
  values               Json
  action               FormAction
  createdPersonId      String?    @map("created_person_id")
  createdCompanyId     String?    @map("created_company_id")
  createdOpportunityId String?    @map("created_opportunity_id")
  personReused         Boolean    @default(false) @map("person_reused")
  ipHash               String?    @map("ip_hash")
  referrer             String?
  createdAt            DateTime   @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([createdAt])
  @@map("form_submissions")
}
